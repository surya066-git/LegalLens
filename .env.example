# LegalLens AI Environment Variables
# ---------------------------------------------------------
# INSTRUCTIONS:
# Copy this file to .env and fill in the actual values.
# NEVER commit the real .env file containing API keys.
# ---------------------------------------------------------

# =========================================================
# BACKEND CONFIGURATION (FastAPI)
# These variables must only be available to the backend server.
# =========================================================

# The Gemini API Key for LLM operations. MUST REMAIN SECRET.
GEMINI_API_KEY=your_gemini_api_key_here

APP_NAME="LegalLens AI"
APP_ENV="production" # Use "development" for local dev

# CORS configuration for the backend. Use the deployed frontend URL in production.
CORS_ORIGINS="http://localhost:3000,https://your-production-frontend-domain.com"

# Storage paths and limits
DOCUMENT_STORAGE_DIR=storage/documents
MAX_PDF_UPLOAD_BYTES=10485760 # 10 MB
MIN_EXTRACTABLE_TEXT_CHARS=20

# =========================================================
# FRONTEND CONFIGURATION (Next.js)
# =========================================================

# Server-side API Proxy URL.
# The Next.js server needs to know where the FastAPI backend lives.
# In production, this should point to your deployed backend URL.
BACKEND_API_URL=http://127.0.0.1:8000

# Public variables exposed to the browser.
NEXT_PUBLIC_APP_NAME="LegalLens AI"
